# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://homie:homie123@localhost:5432/homie
TEST_DATABASE_URL=postgresql://homie:homie123@localhost:5432/homie_test
# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-this-in-production-very-secret-key
JWT_EXPIRY=30d
REFRESH_TOKEN_SECRET=change-this-too-another-secret-key
REFRESH_TOKEN_EXPIRY=90d

# SMS Provider (for OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://app.posthog.com

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Google Maps (for commute calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# CloudPano (VR viewer)
CLOUDPANO_API_KEY=your_cloudpano_api_key

# CORS
CORS_ORIGIN=http://localhost:19000,http://localhost:19001

# File Upload (AWS S3 or similar)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=homie-uploads
AWS_REGION=ap-south-1
