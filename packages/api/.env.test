# Test Environment Variables
NODE_ENV=test
PORT=3001

# Test Database (separate from development)
DATABASE_URL=postgresql://homie:homie123@localhost:5432/homie_test

# Redis (can share with development)
REDIS_URL=redis://localhost:6379

# Authentication (test keys)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRY=30d
REFRESH_TOKEN_SECRET=test-refresh-secret-key-for-testing-only
REFRESH_TOKEN_EXPIRY=90d

# SMS Provider (mock in tests, no real SMS)
TWILIO_ACCOUNT_SID=test_twilio_sid
TWILIO_AUTH_TOKEN=test_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics (disabled in tests)
POSTHOG_API_KEY=
POSTHOG_HOST=

# Sentry (disabled in tests)
SENTRY_DSN=

# Google Maps (mock in tests)
GOOGLE_MAPS_API_KEY=test_google_maps_key

# CloudPano (mock in tests)
CLOUDPANO_API_KEY=test_cloudpano_key

# CORS
CORS_ORIGIN=http://localhost:19000,http://localhost:19001

# File Upload
AWS_ACCESS_KEY_ID=test_aws_access_key
AWS_SECRET_ACCESS_KEY=test_aws_secret_key
AWS_S3_BUCKET=homie-test-uploads
AWS_REGION=ap-south-1
